{
  "name": "music-bingo-next",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/next-with-localstorage.mjs dev",
    "build": "node scripts/next-with-localstorage.mjs build",
    "start": "node scripts/next-with-localstorage.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:anon-access": "node scripts/check-anon-access.mjs",
    "test:e2e": "node scripts/e2e-flows.mjs",
    "test:py": "python3 -m pytest -q",
    "test": "TZ=Europe/London vitest run",
    "test:utc": "TZ=UTC vitest run",
    "test:unit": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:utc && npm run test:py && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "next": "16.4.1",
    "nosleep.js": "^0.12.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "seedrandom": "^3.0.5",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/seedrandom": "^3.0.8",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.56.0",
    "vitest": "^2.1.9"
  }
}

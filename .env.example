# Copy to `.env.local` (recommended for Next.js) or `.env` and fill in locally. Never commit real values.

# Spotify (required for the in-app "Create Spotify Playlist" button)
# Create these in a Spotify Developer app: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
#
# Redirect URI:
# - By default, the app uses: {your-site-origin}/api/spotify/callback
# - Add BOTH of these in your Spotify app settings to avoid localhost/127.0.0.1 mismatches:
#   - http://127.0.0.1:3000/api/spotify/callback
#   - http://localhost:3000/api/spotify/callback
#
# Optional: override the callback explicitly (must exactly match a Redirect URI in Spotify):
# SPOTIFY_WEB_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Supabase. Project Settings, API. SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL are
# the same project: the first is the service-role client for game data, the
# second is staff sign-in with the public key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# Staff sign-in (required on EVERY build, local included; the build fails naming
# any that is missing). See CLAUDE.md, "Access model".
# This app's own origin: reset and invite links are built on it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Turnstile. Locally, Cloudflare's published test pair always passes:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Pseudonymises emails in the sign-in audit: v1: then `openssl rand -base64 48`.
AUDIT_HMAC_KEY=v1:replace_with_openssl_rand_base64_48_output

# Signs the private host and TV links (at least 16 characters; required in
# production). There is no fallback: without it no link can be made or checked.
LIVE_LINK_SECRET=replace_with_openssl_rand_base64_48_output

# Vercel Cron sends it to /api/cron/auth-maintenance (at least 32 characters;
# required in production).
CRON_SECRET=replace_with_openssl_rand_base64_48_output

# Events and reviews (spec M-7). ANCHOR_API_KEY is Music Bingo's own management
# app key with the read:events scope ("Music Bingo TV"): server only, never
# NEXT_PUBLIC_. Required on a Vercel production build; without it the TV loops
# "See what's on" and the printed pack has no event listings. It replaces the
# key that used to be stored on the venue (brands.event_feed_api_key).
# ANCHOR_API_BASE_URL defaults to https://management.orangejelly.co.uk/api.
# MANAGEMENT_API_TOKEN and MANAGEMENT_API_BASE_URL, the old names, are still
# read for one release; rename them.
# ANCHOR_API_KEY=anch_your_api_key_here
# ANCHOR_API_BASE_URL=https://management.orangejelly.co.uk/api
# Music Bingo's review short link on l.the-anchor.pub (to /feedback). Optional;
# must be an https the-anchor.pub link, never a Google URL. Unset, the Thank
# You screen uses https://l.the-anchor.pub/jls0mu.
# REVIEW_SHORT_URL=
# MANAGEMENT_PUBLIC_EVENTS_BASE_URL=https://www.the-anchor.pub
